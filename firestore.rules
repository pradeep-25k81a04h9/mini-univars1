rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function couplePath(id) {
      return /databases/$(database)/documents/couples/$(id);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(couplePath(coupleId))
        && request.auth.uid in get(couplePath(coupleId)).data.memberIds;
    }

    function validJoin(coupleId) {
      let invite = getAfter(invitePath(resource.data.inviteCode));
      let joiningUser = getAfter(userPath(request.auth.uid));

      return signedIn()
        && exists(couplePath(coupleId))
        && resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && invite.data.coupleId == coupleId
        && invite.data.status == 'claimed'
        && invite.data.claimedBy == request.auth.uid
        && joiningUser.data.coupleId == coupleId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'members', 'updatedAt']);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.coupleId == null;

      allow read: if signedIn() && (
        request.auth.uid == userId
        || (
          resource.data.coupleId is string
          && isCoupleMember(resource.data.coupleId)
        )
      );

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'nickname', 'avatar', 'avatarUrl', 'coupleId', 'updatedAt'])
        && (
          request.resource.data.coupleId == resource.data.coupleId
          || (
            resource.data.coupleId == null
            && request.resource.data.coupleId is string
            && request.auth.uid in getAfter(
              couplePath(request.resource.data.coupleId)
            ).data.memberIds
          )
        );

      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.setupCompleted == false
        && getAfter(userPath(request.auth.uid)).data.coupleId == coupleId
        && getAfter(invitePath(request.resource.data.inviteCode)).data.coupleId == coupleId;

      allow get: if isCoupleMember(coupleId)
        || (
          signedIn()
          && resource.data.memberIds.size() == 1
          && exists(invitePath(resource.data.inviteCode))
          && get(invitePath(resource.data.inviteCode)).data.status == 'active'
          && get(invitePath(resource.data.inviteCode)).data.expiresAt > request.time
        );

      allow list: if false;

      allow update: if (
        isCoupleMember(coupleId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'members',
            'firstMeetingDate',
            'relationshipStartDate',
            'specialDates',
            'setupCompleted',
            'hugsCount',
            'updatedAt'
          ])
      ) || validJoin(coupleId);

      allow delete: if false;

      match /{subcollection}/{documentId} {
        allow read, create, update, delete: if isCoupleMember(coupleId);
      }
    }

    match /invitations/{code} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt > request.time
        && getAfter(couplePath(request.resource.data.coupleId)).data.inviteCode == code
        && getAfter(couplePath(request.resource.data.coupleId)).data.ownerId == request.auth.uid;

      allow get: if signedIn()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time;

      allow list: if false;

      allow update: if signedIn()
        && resource.data.status == 'active'
        && resource.data.createdBy != request.auth.uid
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedAt'])
        && getAfter(couplePath(resource.data.coupleId)).data.memberIds.size() == 2
        && request.auth.uid in getAfter(couplePath(resource.data.coupleId)).data.memberIds;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'active';
    }
  }
}
